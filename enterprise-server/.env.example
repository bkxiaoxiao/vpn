# Copy to .env only for explicit configuration. init-local.mjs generates development defaults.
NODE_ENV=production
PORT=8080
PUBLIC_BASE_URL=https://YOUR_CONTROL_SERVICE.run.app
DATABASE_URL=postgresql://USER:PASSWORD@localhost/relay?host=/cloudsql/PROJECT:REGION:INSTANCE
DATA_KEY=REPLACE_WITH_64_HEX_CHARACTERS
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_TENANT_KEY=
# comma-separated open_id values allowed to administer this application
FEISHU_ADMIN_IDS=
JOB_TOKEN=REPLACE_WITH_A_SEPARATE_RANDOM_TOKEN
