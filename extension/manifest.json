{
  "manifest_version": 3,
  "name": "节点订阅助手",
  "version": "0.1.0",
  "key": "",
  "description": "管理 Shadowsocks / VLESS 订阅，并通过本机 sing-box 为 Chrome 提供代理。",
  "permissions": [
    "alarms",
    "proxy",
    "storage",
    "webRequest",
    "webRequestAuthProvider"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "节点订阅助手"
  },
  "options_page": "options.html"
}
