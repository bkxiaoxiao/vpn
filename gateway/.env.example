# 对外提供 HTTPS 代理的域名，证书必须覆盖该域名。
PUBLIC_PROXY_HOST=proxy.example.com
PUBLIC_PROXY_PORT=443
PUBLIC_API_PORT=8443

# 服务器上已有的 Let's Encrypt 或其他可信证书路径。
TLS_CERT_FILE=/etc/letsencrypt/live/proxy.example.com/fullchain.pem
TLS_KEY_FILE=/etc/letsencrypt/live/proxy.example.com/privkey.pem

# 使用 `openssl rand -hex 32` 分别生成强随机值，不要沿用示例。
GATEWAY_API_TOKEN=replace-with-a-long-random-token
PROXY_USERNAME=chrome-user
PROXY_PASSWORD=replace-with-a-long-random-password

# 固定的 Chrome 扩展来源。
EXTENSION_ORIGIN=chrome-extension://pinmpjcfbiejgkhccadaffmicjoodpje

# 默认拒绝网关访问内网订阅地址，以防 SSRF。
ALLOW_PRIVATE_SUBSCRIPTIONS=false
SUBSCRIPTION_MAX_BYTES=2097152
