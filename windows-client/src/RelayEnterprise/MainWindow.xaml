<Window x:Class="RelayEnterprise.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Relay 企业连接" Width="1040" Height="790" MinWidth="900" MinHeight="700" WindowStartupLocation="CenterScreen" Background="#F7FAF7" Icon="Assets/Relay.ico">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="218"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#F1F8F2" BorderBrush="#E5ECE6" BorderThickness="0,0,1,0"><Grid Margin="25,34"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel><StackPanel Orientation="Horizontal"><Border Background="#216D52" CornerRadius="11" Width="43" Height="43"><TextBlock Text="↗" FontSize="35" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="relay" FontSize="34" FontWeight="Bold" Margin="10,0,0,0"/></StackPanel><TextBlock Text="企业专属客户端" FontWeight="SemiBold" Margin="0,34,0,7"/><TextBlock Text="Windows · 安装测试版" Foreground="#8C9991" FontSize="12"/><Border Background="#DFEDE2" CornerRadius="10" Margin="0,30,0,0" Padding="13"><TextBlock Text="◎  企业连接" Foreground="#216D52" FontWeight="SemiBold"/></Border></StackPanel>
   <Border Grid.Row="2" Background="#FAFDFA" CornerRadius="12" Padding="17" Margin="0,0,0,25"><StackPanel><TextBlock Text="♧" FontSize="30" Foreground="#216D52"/><TextBlock Text="以企业身份连接" FontWeight="SemiBold" Margin="0,15,0,10"/><TextBlock Text="只有完成飞书登录，才能同步配置和使用线路。" TextWrapping="Wrap" Foreground="#8C9991" FontSize="12" LineHeight="22"/></StackPanel></Border>
   <DockPanel Grid.Row="3"><Button DockPanel.Dock="Right" Content="退出" Click="Logout" Visibility="{Binding IsAuthenticated,Converter={StaticResource Visible}}" Padding="5" Margin="0"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center"/></DockPanel>
  </Grid></Border>
  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="34,31">
   <DockPanel Margin="0,0,0,27"><TextBlock Text="{Binding AuthLabel}" DockPanel.Dock="Right" Foreground="#216D52" HorizontalAlignment="Right"/><TextBlock Text="WORKSPACE CONNECTION" FontSize="11" Foreground="#8C9991" FontWeight="SemiBold"/></DockPanel>
   <TextBlock Text="{Binding Headline}" FontSize="32" FontWeight="SemiBold" Margin="0,0,0,10"/>
   <TextBlock Text="使用企业飞书身份，自动获取管理员分配的网络配置。" Foreground="#8C9991" FontSize="14" Margin="0,0,0,27"/>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="企业服务地址" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBox Text="{Binding ServerAddress,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditAddress}" AutomationProperties.AutomationId="server-address"/><TextBlock Text="正式服务使用 HTTPS。请填写企业控制服务地址。" Foreground="#8C9991" FontSize="11" Margin="0,12,0,0"/></StackPanel></Border>
   <UniformGrid Columns="3" Margin="12,7,0,26"><TextBlock Text="{Binding LoginStep}" HorizontalAlignment="Center" Foreground="#216D52"/><TextBlock Text="{Binding SyncStep}" HorizontalAlignment="Center" Foreground="#216D52"/><TextBlock Text="{Binding ConnectStep}" HorizontalAlignment="Center" Foreground="#216D52"/></UniformGrid>
   <Border Style="{StaticResource Card}"><StackPanel>
    <DockPanel Margin="0,0,0,20"><TextBlock Text="{Binding RevisionLabel}" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="#8C9991" FontSize="12"/><TextBlock Text="企业线路" FontWeight="SemiBold" FontSize="16"/></DockPanel>
    <TextBlock Text="登录后自动同步；已登录账号需管理员发布或分配线路。" Visibility="{Binding EmptyRoutes,Converter={StaticResource Visible}}" Foreground="#8C9991" Margin="0,4,0,18"/>
    <StackPanel Visibility="{Binding HasRoutes,Converter={StaticResource Visible}}">
     <DockPanel><TextBlock Text="选择线路" VerticalAlignment="Center" Margin="0,0,14,0"/><ComboBox ItemsSource="{Binding Routes}" SelectedItem="{Binding SelectedRoute,Mode=TwoWay}" SelectionChanged="RouteChanged" IsEnabled="{Binding CanPickRoute}" DisplayMemberPath="Label" Padding="8,7" FontSize="13" AutomationProperties.AutomationId="route-picker"/></DockPanel>
     <TextBlock Text="{Binding LatencyLabel}" FontSize="11" Foreground="#8C9991" Margin="0,10,0,7"/>
     <TextBlock Text="{Binding MeteringLabel}" FontSize="11" Foreground="#8C9991" Margin="0,0,0,10"/>
    </StackPanel>
    <Separator Margin="0,10,0,15" Background="#DBE4DE"/>
    <CheckBox Content="接管当前用户的系统代理" IsChecked="{Binding UseSystemProxy}" IsEnabled="{Binding CanEditProxy}" FontSize="13"/>
    <TextBlock Text="代理遵循 Windows 系统代理设置的应用；本版不提供全设备 TUN 模式。" TextWrapping="Wrap" FontSize="11" Foreground="#8C9991" Margin="0,12,0,0"/>
    <Separator Margin="0,15,0,10"/><DockPanel><Button Content="选择本机应用…" Click="AppRouting" IsEnabled="{Binding CanEditProxy}" DockPanel.Dock="Right"/><StackPanel><TextBlock Text="应用分流" FontWeight="SemiBold"/><TextBlock Text="{Binding AppRoutingLabel}" Foreground="#8C9991" FontSize="11"/></StackPanel></DockPanel>
    <TextBlock Text="断开连接后可修改；仅对进入本地代理的流量生效。" TextWrapping="Wrap" FontSize="11" Foreground="#8C9991"/>
   </StackPanel></Border>
   <WrapPanel Margin="0,3,0,16">
    <Button Content="{Binding LoginLabel}" Click="Login" Style="{StaticResource Primary}" IsEnabled="{Binding CanLogin}" Visibility="{Binding ShowLogin,Converter={StaticResource Visible}}" AutomationProperties.AutomationId="feishu-login"/>
    <Button Content="取消登录" Click="CancelLogin" Visibility="{Binding CanCancel,Converter={StaticResource Visible}}"/>
    <Button Content="同步配置" Click="Sync" IsEnabled="{Binding CanSync}" AutomationProperties.AutomationId="sync-policy"/>
    <Button Content="连接" Click="Connect" Style="{StaticResource Primary}" IsEnabled="{Binding CanConnect}" Visibility="{Binding CanEditProxy,Converter={StaticResource Visible}}" AutomationProperties.AutomationId="connect"/>
    <Button Content="断开连接" Click="Disconnect" Style="{StaticResource Primary}" Visibility="{Binding IsConnected,Converter={StaticResource Visible}}"/>
   </WrapPanel>
   <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#73867A" FontSize="12" LineHeight="21" Margin="0,0,0,12"/>
   <TextBlock Text="{Binding PortLabel}" FontSize="11" Foreground="#8C9991"/>
   <Button Content="恢复系统代理" Click="Recover" HorizontalAlignment="Left" Margin="0,14,0,0" Visibility="{Binding ShowRecovery,Converter={StaticResource Visible}}"/>
   <TextBlock Text="Relay Enterprise 0.1.3 · Windows x64" Foreground="#AAB4AD" FontSize="10" Margin="0,25,0,0"/>
  </StackPanel></ScrollViewer>
 </Grid>
</Window>
